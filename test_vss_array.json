{
  "Vehicle": {
    "type": "branch",
    "description": "High-level vehicle data.",
    "children": {
      "Body": {
        "type": "branch",
        "description": "All body components.",
        "children": {
          "Horn": {
            "type": "branch",
            "description": "Horn signals",
            "children": {
              "HornControl": {
                "type": "actuator",
                "datatype": "uint32[]",
                "description": "Horn control array [ControlCommand, ClientID] where ControlCommand: 0=Off, 1=On; ClientID: Priority value",
                "comment": "Array format: [command, priority]"
              },
              "IsActive": {
                "type": "actuator",
                "datatype": "boolean",
                "description": "Horn active status"
              }
            }
          },
          "Lights": {
            "type": "branch",
            "description": "Light signals",
            "children": {
              "ExteriorLightControl": {
                "type": "actuator",
                "datatype": "uint32[]",
                "description": "Exterior light control array [ControlCommand, ClientID]",
                "comment": "Array format: [command, priority]"
              }
            }
          }
        }
      },
      "Speed": {
        "type": "sensor",
        "datatype": "float",
        "unit": "km/h",
        "description": "Vehicle speed"
      }
    }
  }
}